{
    "name": "osirisgate/core",
    "type": "library",
    "description": "Core library for Osirisgate components.",
    "keywords": ["core", "osirisgate"],
    "license": "MIT",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "symfony/var-dumper": "7.3.x-dev",
        "phpunit/phpunit": "12.2.x-dev",
        "friendsofphp/php-cs-fixer": "dev-master",
        "phpstan/phpstan": "2.1.x-dev"
    },
    "autoload": {
        "psr-4": {
            "Osirisgate\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Osirisgate\\Core\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Ulrich Geraud AHOGLA",
            "email": "developer@osirisgate.com"
        }
    ],
    "scripts": {
        "phpcs-fix": "PHP_CS_FIXER_IGNORE_ENV=1 vendor/bin/php-cs-fixer fix --allow-risky=yes --path-mode=intersection --config=.php-cs-fixer.dist.php src/",
        "phpstan": "vendor/bin/phpstan analyse -c phpstan.dist.neon -l 9 src/"
    }
}
